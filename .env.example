# Copy to .env and fill in. Without FAL_KEY + IMGBB_API_KEY the app runs in MOCK mode.

# fal.ai API key (https://fal.ai/dashboard/keys) — used for Gemini image edit + WAN i2v
FAL_KEY=

# imgbb API key (https://api.imgbb.com/) — used to host images for the AI models
IMGBB_API_KEY=

# Optional — upload-post.com integration (TikTok / Instagram / YouTube)
UPLOAD_POST_API_KEY=

# Optional overrides
PORT=3000
NUMBER_OF_IMAGES=1
POLL_INTERVAL_MS=5000
POLL_MAX_ATTEMPTS=60
